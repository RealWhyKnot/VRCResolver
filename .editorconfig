root = true

[*.{sh,bash}]
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
simplify = true

[[shell]]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
simplify = true

[{vendor,third_party,node_modules,.yarn}/**]
ignore = true

[**/{vendor,third_party,node_modules,.yarn}/**]
ignore = true
